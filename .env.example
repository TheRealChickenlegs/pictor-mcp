# pictor-mcp configuration template.
#
#   cp .env.example .env
#   # generate a token, then paste it into PICTOR_AUTH_TOKEN below:
#   openssl rand -hex 32
#   docker compose up -d
#
# Every value shown is the server's own default unless the comment says
# otherwise, so an empty/commented line and the value shown behave identically.
# Compose interpolates these into the container; the same names work for a bare
# `docker run` or a native install.
#
# Booleans accept 1/true/yes/on/y/t and 0/false/no/off/n/f (case-insensitive).
# Lists (hosts, origins, ports, roots, fonts) are comma- or whitespace-separated.
# An invalid or out-of-range value makes the server REFUSE TO START rather than
# fall back to a less safe default - check `docker compose logs` on failure.
#
# Section 0 below is different from the rest: those settings are read by Compose
# itself, not by the server, which is why they have no PICTOR_ prefix.

# =============================================================================
# 0. Compose deployment (read by Compose, not by the server)
# =============================================================================
# Registry path for the published images, without a tag. Change this only if you
# mirror the images somewhere else.
IMAGE_REPO=ghcr.io/therealchickenlegs/pictor-mcp
# Tag for the CPU image used by docker-compose.yml. `latest` follows the default
# branch; pin an exact version for a reproducible deployment:
#   IMAGE_TAG=1.0.0
IMAGE_TAG=latest
# Tag for the CUDA image used by docker-compose.gpu.yml.
#   IMAGE_TAG_GPU=1.0.0-gpu
IMAGE_TAG_GPU=gpu
# Tag for the ML image used by docker-compose.ml.yml (CUDA + background removal,
# with the u2net weights baked in).
#   IMAGE_TAG_ML=1.0.0-ml
IMAGE_TAG_ML=ml
# Host interface the published port binds to.
#   127.0.0.1  loopback only - nothing off-host can reach it (default, safest)
#   0.0.0.0    every interface - reachable from your LAN; see PICTOR_ALLOWED_HOSTS
#              and PICTOR_ALLOWED_ORIGINS below, and set PICTOR_AUTH_TOKEN
#   <lan-ip>   one specific interface, e.g. 192.168.1.10
BIND_ADDRESS=127.0.0.1
# The uid and gid the container runs as. Setting these to your own identity is
# what makes files in ./output belong to you instead of to an unrelated account,
# and it is why the quick start needs no `chown`.
#
#   id -u    # your uid, e.g. 1000
#   id -g    # your gid, e.g. 1000
#
# The defaults suit a typical single-user Linux desktop. On a system where your
# uid is not 1000, or in a rootless Docker setup with subuid remapping, set these
# to the values `id -u` and `id -g` report.
#
# The alternative is to leave them alone and make the host directories match the
# container instead:  sudo chown -R 1000:1000 input output
#
# Do NOT set either to 0. Running as root would defeat the container hardening
# (cap_drop, no-new-privileges, read-only root) and is not needed: /data/output is
# writable by any uid.
PUID=1000
PGID=1000

# =============================================================================
# 1. Transport and bind address
# =============================================================================
# stdio | streamable-http | sse. Use streamable-http in Docker; stdio is for a
# client that launches the process itself.
PICTOR_TRANSPORT=streamable-http
# 0.0.0.0 inside the container is correct: the *port mapping* in
# docker-compose.yml decides who can reach it, and that defaults to loopback.
# For a native (non-container) install set this to 127.0.0.1 instead. Note that
# a non-loopback value with no explicit PICTOR_ALLOWED_HOSTS below makes the
# server accept any Host header, so pair the two when running natively.
PICTOR_HOST=0.0.0.0
# The port the server listens on *inside* the container. Compose publishes this
# same number on the host, so changing it moves both ends together; to publish
# on a different host port, edit the `ports:` line in docker-compose.yml.
PICTOR_PORT=8077
# Endpoint path for the streamable-http and sse transports.
PICTOR_STREAMABLE_HTTP_PATH=/mcp
# Serve modern MCP requests without a session handshake. The SDK still handles
# legacy `initialize` clients on the same endpoint; leave this alone unless a
# specific client misbehaves.
PICTOR_STATELESS_HTTP=true
# Return plain JSON responses instead of SSE streams. Off is correct for the
# streamable-http transport; only enable for a client that cannot read SSE.
PICTOR_JSON_RESPONSE=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
PICTOR_LOG_LEVEL=INFO

# =============================================================================
# 2. Filesystem jail (read roots / write root)
# =============================================================================
# All reads are confined to these directories. Absolute paths only; the server
# rejects relative entries at startup.
PICTOR_INPUT_ROOTS=/data/input
# The ONLY writable directory. It must not overlap an input root, and the
# server refuses to start if it does.
PICTOR_OUTPUT_ROOT=/data/output
# Directories scanned for fonts by the text-watermark tool. Callers pick a font
# by NAME from this index and can never supply a path, so this is not another
# file-read primitive. fonts-dejavu-core is installed in the image.
PICTOR_FONT_DIRS=/usr/share/fonts

# =============================================================================
# 3. Authentication and output serving
# =============================================================================
# Pre-shared bearer token for the HTTP transports. Leave empty ONLY when the
# port is bound to loopback or fronted by an authenticating proxy; anyone who
# can reach the port can otherwise read and write inside /data.
# Generate with:  openssl rand -hex 32
# Minimum 16 characters - a shorter value is a startup error, not a warning.
# PICTOR_AUTH_TOKEN=
# HMAC secret used to sign /files/ URLs. Defaults to PICTOR_AUTH_TOKEN, which is
# usually what you want. Set it separately only if you want signed links to
# outlive a token rotation.
# PICTOR_URL_SECRET=
# Lifetime of a signed output URL, in seconds (60 .. 2592000).
PICTOR_URL_TTL_SECONDS=3600
# Serve generated images over HTTP at /files/<path> so browser UIs can render
# them. Refused at startup unless PICTOR_AUTH_TOKEN or PICTOR_URL_SECRET is set,
# because otherwise every image ever produced would be world-readable.
PICTOR_SERVE_OUTPUTS=false
# Absolute base URL used to build links when running behind a reverse proxy.
# Must start with http:// or https:// if set.
# PICTOR_PUBLIC_BASE_URL=

# =============================================================================
# 4. DNS-rebinding protection (Host / Origin allow-lists)
# =============================================================================
# Validates the Host and Origin headers; this is the MCP-spec DNS-rebinding
# defence. Turning it off exposes a local server to a malicious web page.
PICTOR_DNS_REBINDING_PROTECTION=true
# Host header allow-list. Leave this empty and the server derives a loopback
# list (127.0.0.1, localhost, [::1]) from PICTOR_HOST.
#
# docker-compose.yml passes an explicit list so the effective value is visible
# without reading the source. It covers loopback AND `pictor-mcp:*`, the compose
# service name, because that is how another container on the same Docker network
# reaches this one: it calls http://pictor-mcp:8077/mcp, so the Host header is
# `pictor-mcp:8077`.
#
# If a container is refused with "host header ... is not allowed", it is calling
# by a name that is not on the list. Add exactly that name:
#   PICTOR_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,pictor-mcp:*,192.168.10.5:8077
# The value logged with the rejection is the one to add.
#
# Accepted forms:
#   127.0.0.1:8077   that host, that port only
#   127.0.0.1:*      that host on any port (also matches the port-less form)
#   *.example.com    any subdomain, on any port; the apex example.com does NOT match
#   *.example.com:8077  any subdomain, that port only
#   *                any Host at all. Only sane behind a hardened proxy, because
#                    it removes the DNS-rebinding defence entirely.
#
# A name that is not a pattern is matched exactly, port included.
# This pattern grammar is interpreted by this server alone: the MCP SDK's own
# Host check, which understands only exact values and `name:*`, is deliberately
# not given a say, so the value here is the value that applies.
# PICTOR_ALLOWED_HOSTS=
# Browser Origin allow-list. An EMPTY list means no browser Origin is accepted:
# CLI/MCP clients (which send no Origin) still work, a cross-site page does not.
# Add your web UI origin when needed, e.g. http://192.168.1.10:3000
# The same forms apply, with an optional scheme:
#   http://127.0.0.1:*   any port on loopback, over http
#   https://*.example.com  any subdomain over https, any port
PICTOR_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
# Emit Strict-Transport-Security. Only enable when TLS terminates in front of
# this server (otherwise you can lock browsers out of the plain-HTTP host).
PICTOR_ENABLE_HSTS=false
# uvicorn's per-request access log. Off by default: signed /files/ URLs carry
# their HMAC signature in the query string, so a logged line is a usable
# credential for as long as the link works. Application logging is unaffected.
PICTOR_HTTP_ACCESS_LOG=false

# =============================================================================
# 5. Outbound URL fetching (image input by URL)
# =============================================================================
# Off by default. When on, private/loopback/link-local addresses stay blocked
# regardless of the allow-list.
PICTOR_ALLOW_NET_FETCH=false
# Empty means "any public host". Example: cdn.example.com,images.example.org
PICTOR_FETCH_ALLOWED_HOSTS=
PICTOR_FETCH_ALLOWED_PORTS=80,443
PICTOR_FETCH_MAX_BYTES=33554432
PICTOR_FETCH_MAX_REDIRECTS=3
PICTOR_FETCH_TIMEOUT_SECONDS=15
# Only disable for a pinned internal mirror: it turns off certificate checks.
PICTOR_FETCH_VERIFY_TLS=true

# =============================================================================
# 6. Resource limits and decompression-bomb guards
# =============================================================================
# Every limit below is enforced before or during a decode, so a hostile file
# fails fast instead of exhausting memory or a worker.
PICTOR_MAX_PIXELS=64000000
PICTOR_MAX_FILE_BYTES=67108864
PICTOR_MAX_DIMENSION=24000
PICTOR_MAX_FRAMES=120
# Ceiling on width x height x frames. A multi-frame image is decoded into one
# full bitmap per frame before re-encoding, so this is the limit that actually
# bounds animation memory; 2000x2000 over 120 frames is 480 MP and would
# otherwise allocate roughly 2 GB.
PICTOR_MAX_ANIMATION_PIXELS=128000000
PICTOR_MAX_OUTPUT_PIXELS=256000000
PICTOR_MAX_REQUEST_BODY_BYTES=50331648
PICTOR_MAX_EXIF_BYTES=65536
# Concurrent image operations (1 .. 64).
PICTOR_MAX_CONCURRENCY=4
# Files touched by a single image_batch call (1 .. 10000).
PICTOR_MAX_BATCH_FILES=64
# Wall-clock budget for one tool call, in seconds.
PICTOR_OP_TIMEOUT_SECONDS=120
# Largest base64 image accepted in a tool call.
PICTOR_MAX_INPUT_BASE64_BYTES=50331648
# Largest image embedded inline in a tool result (0 disables inlining).
PICTOR_MAX_INLINE_IMAGE_BYTES=1048576

# =============================================================================
# 7. Image pipeline behaviour
# =============================================================================
# Strip EXIF/GPS/ICC from outputs unless a caller explicitly asks to keep it.
PICTOR_STRIP_METADATA=true
# Embed the resulting image in tool results so vision-capable clients can see it.
PICTOR_INLINE_IMAGES=true
# Background-removal model passed to rembg (u2net, u2netp, isnet-general-use...).
# The `ml` image bakes u2net in; other models need network access on first use.
PICTOR_BG_MODEL=u2net

# =============================================================================
# 8. GPU (docker compose --profile gpu / -f docker-compose.gpu.yml)
# =============================================================================
# auto  = use CUDA only when torch can actually see a device, else CPU.
# off   = never use the GPU (correct value for the CPU image).
# torch = require CUDA; fail to start if it is unavailable.
# cuda  = accepted alias for the torch backend.
#
# Leave this commented out. docker-compose.yml already picks the right default
# per service (the CPU service sets `off`, the GPU service and the GPU overlay
# set `auto`), so setting it here would override that for both.
# PICTOR_GPU=auto
# Below this pixel count the host<->device copy costs more than the CPU resize,
# so small images deliberately stay on the CPU.
PICTOR_GPU_MIN_PIXELS=4000000
# rembg caches its ONNX models in <U2NET_HOME>/models/<name>/. The `ml` image
# pre-downloads u2net there at build time, so that model is available with no
# network and no writable root filesystem. Any OTHER model name needs its weights
# pre-downloaded the same way (or a writable mount under this path) first.
U2NET_HOME=/opt/models
